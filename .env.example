# Copy to .env and replace the token and LAN address. No quotes needed.
MOTIONMOUSE_TOKEN=replace-with-at-least-32-random-characters
MOTIONMOUSE_ORIGINS=https://192.168.1.50:8000,https://localhost:8000,https://192.168.1.50:5173,https://localhost:5173
# uinput controls the real cursor; log records events without injecting input.
MOTIONMOUSE_OUTPUT=uinput
MOTIONMOUSE_GAIN=2400
MOTIONMOUSE_FILTER_TAU=0.04
MOTIONMOUSE_DAMPING=2.0
MOTIONMOUSE_QUIET_SECONDS=0.15
MOTIONMOUSE_SAMPLE_GAP=0.15
# Network arrival watchdog is separate from the phone's integration sample gap.
MOTIONMOUSE_STREAM_TIMEOUT=0.5
# Maximum extra delivery delay relative to the best observed delay, seconds.
MOTIONMOUSE_MAX_SAMPLE_DELAY=0.25
MOTIONMOUSE_GESTURE_SECONDS=2.0
MOTIONMOUSE_MAX_VELOCITY=1.5
MOTIONMOUSE_ROTATION_LIMIT=35
MOTIONMOUSE_TILT_LIMIT=12
